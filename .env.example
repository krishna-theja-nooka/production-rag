# Create your private config with: python -m production_rag init-env
RAG_DB_PATH=data/index.sqlite3
RAG_RETRIEVAL=lexical
RAG_GENERATOR=extractive
RAG_API_KEY=
# For generation entirely in Python, install .[llm] and set GENERATOR=transformers.
RAG_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
RAG_LLM_DEVICE=cpu
RAG_LLM_CONTEXT_TOKENS=4096
RAG_MAX_NEW_TOKENS=512
RAG_GENERATION_SECONDS=90
# Pin immutable model commit revisions before a controlled release.
# RAG_LLM_REVISION=
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_EMBEDDING_REVISION=
RAG_CORS_ORIGINS=[]
